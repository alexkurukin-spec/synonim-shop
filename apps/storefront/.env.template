# ── Storefront env (copy to apps/storefront/.env.local and fill in) ──

# Medusa backend URL
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key — generated by the backend seed/admin. Set after Phase 1.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Default region (becomes RUB / "ru" in Phase 1; "dk" is the starter default).
NEXT_PUBLIC_DEFAULT_REGION=dk

# Public base URL of the storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe (optional; RU acquiring provider is added in Phase 4)
NEXT_PUBLIC_STRIPE_KEY=

NODE_ENV=development
