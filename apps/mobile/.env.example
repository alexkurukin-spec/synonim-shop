# Скопируй в .env и заполни. Переменные EXPO_PUBLIC_* доступны в коде приложения.

# Публичный адрес backend (НЕ localhost — телефон его не видит).
# Локально для теста на эмуляторе можно http://10.0.2.2:9000 (Android) или
# http://<IP-компа>:9000. В проде — адрес задеплоенного backend.
EXPO_PUBLIC_MEDUSA_BACKEND_URL=https://your-backend.example.com

# Publishable-ключ магазина (из сида/админки, тот же что у витрины).
EXPO_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Регион по умолчанию.
EXPO_PUBLIC_DEFAULT_REGION=ru

# (опционально) URL витрины — для перехода к оформлению на сайте,
# пока не готов нативный чекаут (этап 3).
EXPO_PUBLIC_STOREFRONT_URL=https://your-storefront.example.com

