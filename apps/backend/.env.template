# ── Medusa backend env (copy to apps/backend/.env and fill in) ──

# External Postgres connection string (Neon).
# Example: postgres://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/synonim?sslmode=require
# Provided at the migration step.
DATABASE_URL=

# CORS — storefront (8000) and admin (9000)
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com

# Secrets — replace with strong random values in any shared/prod environment
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Redis (optional). Not required for local dev — Medusa falls back to in-memory.
# Only needed once event bus / cache / workflow modules are configured for Redis.
# REDIS_URL=redis://localhost:6379

# ── ЮKassa (РФ-эквайринг, Фаза 4) ──
# shopId и секретный ключ из ЛК ЮKassa (для теста — магазин в режиме «Тест»).
# Без них провайдер регистрируется, но платежи отклоняются.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — одностадийное списание сразу; false — двухстадийная (authorize → capture).
YOOKASSA_CAPTURE=false
# Куда вернуть покупателя после оплаты (страница заказа сторефронта).
YOOKASSA_RETURN_URL=http://localhost:8000/ru/order/confirmed
